{
  "name": "xteink-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "xteink web UI: upload, library, send-to-device, devices, settings. Built into xteink/server/_webassets.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
