# Copy to .env (gitignored): cp .env.example .env
# Only placeholders live here. Never commit real keys or tokens.

# Compose project name (containers/volumes are prefixed with this).
COMPOSE_PROJECT_NAME=xteink

# Host interface the ports are published on. 0.0.0.0 = LAN/tailnet.
# Use 127.0.0.1 to keep everything host-local (e.g. behind a tunnel only).
XTEINK_PUBLISH_BIND=0.0.0.0
XTEINK_PUBLISH_PORT=8780
XTEINK_PUBLISH_DEVICE_PORT=8781
XTEINK_PUBLISH_MCP_PORT=8782

# Library data: empty = named volume "xteink-data". Or set a host dir (bind mount),
# e.g. XTEINK_DATA_DIR=/srv/xteink-data (must be writable by uid 10001).
XTEINK_DATA_DIR=

# The MCP service holds no key: each MCP client sends its own
# `Authorization: Bearer xtk_...` (mint one per agent with
#   docker compose run --rm api python -m xteink.server create-key <name>).

# Remote access (only used with: docker compose --profile remote up -d)
# One tunnel per hostname (see docs/remote-access.md):
TUNNEL_TOKEN_UI=<tunnel-token-for-ebooks.culture.dev>
TUNNEL_TOKEN_DEVICE=<tunnel-token-for-xteink.culture.dev>

# Cloudflare Access SSO for the web UI on ebooks.culture.dev (optional, set both or neither).
# With both set, a browser signed in through Access needs no xtk_ API key: the api verifies
# the Cf-Access-Jwt-Assertion header Cloudflare adds (main app only, never the device app).
# Both values are in the Zero Trust dashboard: the team domain under Settings, the AUD tag
# on the ebooks.culture.dev Access application. Leave empty to keep Access auth off.
#   XTEINK_ACCESS_TEAM_DOMAIN=<your-team>.cloudflareaccess.com
#   XTEINK_ACCESS_AUD=<application-audience-tag>
XTEINK_ACCESS_TEAM_DOMAIN=
XTEINK_ACCESS_AUD=
